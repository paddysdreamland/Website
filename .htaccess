DirectoryIndex index.php
ErrorDocument 404 /notfound.php

Options -Indexes
RewriteEngine On

# Redirect /page.html or /page.php -> /page (canonical URL, avoids duplicate-content URLs)
# (skip index, since / already serves it via DirectoryIndex)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.(?:html|php)[\s?] [NC]
RewriteCond %1 !^index$ [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve page.html or page.php when /page is requested, without changing the visible URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

<Files "pd_main.html">
    Require all denied
</Files>

<IfModule mod_headers.c>
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
</IfModule>

<FilesMatch "\.(mp3|wav|png|jpg|ttf|otf)$">
    Header unset Cache-Control
    Header unset Pragma
    Header unset Expires
    Header set Cache-Control "max-age=2592000, public"
</FilesMatch>